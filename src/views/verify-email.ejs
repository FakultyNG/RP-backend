<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>Verify your Reeplay account</title>
    <style>
      body { margin: 0; padding: 0; background: #0b0d12; color: #16181d; font-family: Arial, Helvetica, sans-serif; -webkit-text-size-adjust: 100%; }
      table { border-collapse: collapse; }
      .shell { width: 100%; background: #0b0d12; }
      .wrap { width: 100%; max-width: 600px; }
      .card { background: #fffaf7; border: 1px solid #292c33; border-radius: 20px; overflow: hidden; }
      .pad { padding: 44px 48px; }
      .eyebrow { margin: 0 0 14px; color: #e43f45; font-size: 12px; line-height: 18px; font-weight: 700; letter-spacing: 2px; }
      h1 { margin: 0 0 18px; color: #111318; font-size: 34px; line-height: 40px; letter-spacing: -1px; }
      p { margin: 0 0 18px; color: #555a64; font-size: 16px; line-height: 26px; }
      .code { padding: 24px; background: #f4eeea; border: 1px solid #e6ddd8; border-radius: 14px; text-align: center; }
      .code-label { color: #767b84; font-size: 12px; line-height: 18px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; }
      .code-value { margin-top: 8px; color: #111318; font-size: 34px; line-height: 42px; font-weight: 700; letter-spacing: 8px; }
      .note { margin-top: 22px; color: #717680; font-size: 13px; line-height: 21px; }
      .footer { padding: 26px 34px 34px; text-align: center; }
      .footer p { margin: 0 0 7px; color: #9297a1; font-size: 12px; line-height: 18px; }
      a { color: #ff4455; text-decoration: none; }
      @media only screen and (max-width: 620px) { .outer { padding: 18px 12px !important; } .pad { padding: 34px 24px !important; } h1 { font-size: 29px !important; line-height: 35px !important; } .code-value { font-size: 30px !important; letter-spacing: 6px !important; } }
      .shell, .wrap { table-layout: fixed; }
      .wrap { width: 94% !important; }
      .outer { padding-left: 0 !important; padding-right: 0 !important; }
      p { overflow-wrap: break-word; }
    </style>
  </head>
  <body>
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;">Your Reeplay verification code expires in 5 minutes.</div>
    <table role="presentation" class="shell" width="100%"><tr><td class="outer" align="center" style="padding:36px 16px;"><table role="presentation" class="wrap" width="100%">
      <tr><td class="card"><div class="pad">
        <p class="eyebrow">WELCOME TO REEPLAY</p>
        <h1>You’re almost in.</h1>
        <p>Hi <strong style="color:#252830;"><%= name %></strong>, thanks for joining us. Enter the code below in Reeplay to verify your email and finish setting up your account.</p>
        <div class="code"><div class="code-label">Verification code</div><div class="code-value"><%= pin %></div></div>
        <p class="note">This code expires in 5 minutes. If you didn’t create a Reeplay account, you can safely ignore this email.</p>
      </div></td></tr>
      <tr><td class="footer"><p>Need a hand? <a href="mailto:support@reeplay.app">support@reeplay.app</a></p><p>&copy; <%= footerYear %> Reeplay. Made for moments worth watching.</p></td></tr>
    </table></td></tr></table>
  </body>
</html>
