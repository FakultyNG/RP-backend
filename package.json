{
  "name": "reeplay-backend",
  "version": "1.0.0",
  "description": "reeplay mobile app, netflix and other similar apps compatible",
  "main": "src/index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test": "jest",
    "test:live-contract": "npm run build && node scripts/verify-live-contract.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prest": "nodemon --exec \"npm run format && node\" src/index.js",
    "dev": "cross-env NODE_ENV=development nodemon -e ts --watch src .env --exec \"tsc --incremental && node build/src/index.js\" || exit 1",
    "start": "cross-env NODE_ENV=production node build/src/index.js",
    "build": "rimraf build && tsc",
    "migrate:railway-hls": "node build/src/migrations/migrateRailwayHls.js",
    "cleanup:legacy-mp4-welcome-ads": "node build/src/migrations/cleanupLegacyMp4AndWelcomeAds.js",
    "migrate:content-access": "node build/src/migrations/migrateContentAccess.js",
    "docs:generate": "node scripts/generate-api-docs.mjs",
    "configure:s3-multipart": "node scripts/configure-s3-multipart.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-mediaconvert": "^3.812.0",
    "@aws-sdk/client-s3": "^3.577.0",
    "@aws-sdk/cloudfront-signer": "^3.598.0",
    "@aws-sdk/lib-storage": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.577.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "axios": "^1.13.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "express-useragent": "^2.0.1",
    "firebase-admin": "^13.4.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^10.9.1",
    "http-status": "^2.0.0",
    "jest": "^30.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^8.8.4",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.5.0",
    "paystack-sdk": "^2.5.17",
    "rimraf": "^6.0.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-useragent": "^1.0.5",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node-cron": "^3.0.11",
    "@types/node-media-server": "^2.3.7",
    "@types/nodemailer": "^6.4.17",
    "@types/swagger-ui-express": "^4.1.8",
    "chai": "^5.1.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.0",
    "prettier": "^3.3.2",
    "railway": "^3.17.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2"
  }
}
