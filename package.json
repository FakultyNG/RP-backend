{
     "name": "reeplay-backend",
     "version": "1.0.0",
     "description": "reeplay mobile app, netflix and other similar apps compatible",
     "main": "src/index.js",
     "engines": {
          "node": ">=22 <23"
     },
     "scripts": {
          "test": "cross-env NODE_ENV=test ENV_FILE=.env.test jest --runInBand",
          "test:external": "cross-env NODE_ENV=test ENV_FILE=.env.test RUN_EXTERNAL_TESTS=true jest --runInBand",
          "format": "prettier --write .",
          "dev": "cross-env NODE_ENV=development ENV_FILE=.env.development nodemon src/index.js",
          "start": "node src/entrypoint.js",
          "start:media": "node src/media-server.js"
     },
     "keywords": [],
     "author": "",
     "license": "ISC",
     "dependencies": {
          "@aws-sdk/client-mediaconvert": "^3.592.0",
          "@aws-sdk/client-s3": "^3.577.0",
          "@aws-sdk/cloudfront-signer": "^3.598.0",
          "@aws-sdk/s3-request-presigner": "^3.577.0",
          "@ffmpeg-installer/ffmpeg": "^1.1.0",
          "axios": "^1.6.8",
          "bcrypt": "^5.1.1",
          "cors": "^2.8.5",
          "dotenv": "^16.4.5",
          "ejs": "^3.1.10",
          "express": "^4.19.2",
          "express-eventsource": "^0.0.4",
          "express-fileupload": "^1.5.0",
          "firebase-admin": "^12.1.1",
          "google-auth-library": "^9.11.0",
          "jsonwebtoken": "^9.0.2",
          "mongoose": "^8.4.3",
          "node-cron": "^3.0.3",
          "node-media-server": "^2.7.0",
          "node-schedule": "^2.1.1",
          "nodemailer": "^6.9.13",
          "socket.io": "^4.7.5"
     },
     "devDependencies": {
          "chai": "^5.1.1",
          "cross-env": "^7.0.3",
          "jest": "^29.7.0",
          "mocha": "^10.7.0",
          "nodemon": "^3.1.0",
          "prettier": "^3.3.2",
          "railway": "^3.17.0",
          "supertest": "^7.0.0"
     }
}
