# Copy to .env.development for local work. Never put production secrets here.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
MONGO_URL=mongodb://reeplay_dev:change-me-local-only@127.0.0.1:27017/reeplayDB?authSource=admin
MONGO_DB_NAME=reeplayDB

JWT_SECRET=replace-with-a-long-development-only-value
JWT_SECRET_REFRESH_TOKEN=replace-with-another-long-development-only-value
GUEST_TOKEN=replace-with-a-development-only-guest-token

ENABLE_CRON_JOBS=false
ENABLE_MEDIA_SERVER=false
ENABLE_FIREBASE=false
# Railway-friendly alternative to GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_BASE64=
GOOGLE_APPLICATION_CREDENTIALS=C:\\secure\\path\\reeplay-dev-firebase.json
FIREBASE_TEST_DEVICE_TOKEN=
ALLOW_AWS_IN_DEVELOPMENT=false
ALLOW_EXTERNAL_PAYMENTS=false

# Populate only for an approved, isolated test environment.
S3REGION=
S3_BUCKET=
S3ACCESS_KEY=
S3SECRET_KEY=
IAM_ROLE_ARN=
CFSDISTRIBUTION=
KEY_PAIR_ID=
CFS_PRIVATE_KEY=
RP_RTMPURL=
RP_HLSURL=
MEDIA_SERVER_PORT=8888
PAYSTACK_SECRET_KEY=
MAILTRAP_USER=
MAILTRAP_PASS=
MAIL_SENDER=
EVENT_HOURLY_CHARGES=0
MONGO_ROOT_USERNAME=reeplay_dev
MONGO_ROOT_PASSWORD=change-me-local-only
